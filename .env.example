# Copy to apps/api/.env

PORT=8787

# mock | mcp  ("live" maps to mcp)
HSP_MODE=mock
HSP_MCP_URL=https://mcp-qa.hashkeymerchant.com/
HSP_BASE_URL=https://merchant-qa.hashkeymerchant.com
HSP_POLL_MAX_MS=120000

MERCHANT_NAME=Charter

APP_KEY=
APP_SECRET=
MERCHANT_PRIVATE_KEY_PATH=

# HSP recipient (≠ agent). Used by MCP create_order.
PAY_TO_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# HSP / display defaults (HashKey QA)
NETWORK=hashkey-testnet
CHAIN_ID=133
USDC_CONTRACT=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6
RPC_URL=https://testnet.hsk.xyz
EXPLORER_BASE=https://testnet-explorer.hsk.xyz

# MandateVault — can be Sepolia while HSP settle stays on HashKey MCP
# After: ./contracts/script/deploy-sepolia.sh
VAULT_ADDRESS=
VAULT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VAULT_CHAIN_ID=11155111
VAULT_USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
VAULT_EXPLORER_BASE=https://sepolia.etherscan.io

OWNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AGENT_WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

REDIRECT_BASE_URL=http://localhost:5173
